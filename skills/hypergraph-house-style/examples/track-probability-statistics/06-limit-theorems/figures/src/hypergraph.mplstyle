# The Hypergraph Project house style for Matplotlib, version 1.0.0.
# Use:  plt.style.use("figures/src/hypergraph.mplstyle")
# Rules: references/plots.md. Install the Geist font for exact output;
# without it Matplotlib falls back to a similar sans-serif.
# Colours are written without "#", which starts a comment in this file.

figure.figsize: 7.2, 4.05
figure.dpi: 100
figure.facecolor: FFFFFF
figure.edgecolor: FFFFFF

font.family: sans-serif
font.sans-serif: Geist, Helvetica Neue, Arial, DejaVu Sans
font.size: 11
mathtext.fontset: cm
text.color: 0F0F0F

axes.facecolor: FFFFFF
axes.edgecolor: 0F0F0F
axes.linewidth: 1
axes.labelcolor: 0F0F0F
axes.labelsize: 11
axes.labelpad: 6
axes.titlesize: 11
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.axisbelow: True
axes.xmargin: 0.02
axes.ymargin: 0.05
axes.prop_cycle: cycler(color=["0F0F0F", "5C5C5C", "8A8A88"], linestyle=["-", "--", ":"])

lines.linewidth: 1.5
lines.markersize: 4
lines.solid_capstyle: round
lines.dash_capstyle: round

patch.facecolor: EBEBEA
patch.edgecolor: 0F0F0F
patch.linewidth: 1

xtick.color: 0F0F0F
ytick.color: 0F0F0F
xtick.labelcolor: 5C5C5C
ytick.labelcolor: 5C5C5C
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.major.width: 1
ytick.major.width: 1
xtick.minor.visible: False
ytick.minor.visible: False

legend.frameon: False
legend.fontsize: 10

image.cmap: Greys
errorbar.capsize: 0
hist.bins: auto
scatter.edgecolors: none

savefig.format: svg
savefig.bbox: tight
savefig.pad_inches: 0.1
savefig.facecolor: FFFFFF
savefig.transparent: False
svg.fonttype: path
svg.hashsalt: hypergraph
