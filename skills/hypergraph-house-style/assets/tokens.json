{
  "name": "The Hypergraph Project house style",
  "version": "1.2.0",
  "colour": {
    "ink": "#0F0F0F",
    "muted": "#5C5C5C",
    "construction": "#8A8A88",
    "line": "#DEDEDC",
    "fill": "#EBEBEA",
    "ground": "#F5F5F4",
    "surface": "#FFFFFF",
    "stage": "#0F0F0F",
    "stageInk": "#F5F5F4",
    "stageMuted": "#A3A3A1",
    "stageLine": "#2C2C2B"
  },
  "font": {
    "sans": "Geist",
    "mono": "Geist Mono",
    "pixel": "Geist Pixel",
    "maths": "KaTeX (Computer Modern)",
    "sources": "https://fonts.google.com/specimen/Geist and https://github.com/vercel/geist-font (SIL Open Font License)"
  },
  "figure": {
    "width": 720,
    "wideWidth": 1080,
    "margin": 24,
    "grid": 24,
    "stroke": 1.5,
    "constructionStroke": 1,
    "dash": "6 4",
    "pointRadius": 4,
    "cornerRadius": 4,
    "labelSize": 14,
    "maxKB": 100
  },
  "plot": {
    "widthPx": 720,
    "heightPx": 405,
    "maxSeries": 3,
    "seriesOrder": ["ink solid", "muted dashed", "construction dotted"]
  },
  "simulation": {
    "minWidth": 320,
    "aspect": "16 / 10",
    "maxKB": 150
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "loudnessLUFS": -14,
    "truePeakDBTP": -1,
    "minTextPx": 28,
    "titleCardSeconds": 3,
    "endCardSeconds": 8,
    "thumbnail": { "width": 1280, "height": 720 }
  }
}
